digraph LinuxTree {
 graph [rankdir=TB, bgcolor="white", nodesep=.5, ranksep=.56, pad=.2, splines=polyline, fontname="DejaVu Sans"];
 node [fontname="DejaVu Sans", fontsize=15, style="rounded,filled", shape=box, fillcolor="#F2F5F9", color="#94A3B8", penwidth=1.2, margin=".12,.10"];
 edge [color="#94A3B8", penwidth=1.3, arrowhead=none];
 root [label="/ — корень", fillcolor="#DBEAFE", fontsize=18, penwidth=2];
 etc [label="/etc\nнастройки"];
 home [label="/home\nпользователи"];
 usr [label="/usr\nпрограммы"];
 var [label="/var\nжурналы и данные"];
 proc [label="/proc\nпроцессы"];
 dev [label="/dev\nустройства"];
 tmp [label="/tmp\nвременное"];
 boot [label="/boot\nзагрузчик"];
 root -> {etc home usr var proc dev tmp boot};
}
